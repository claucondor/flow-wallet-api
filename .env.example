# ==============================================================================
# Flow Wallet API Environment Configuration Example
# Copy to .env and adjust values as needed
# ==============================================================================

# Docker Configuration
DOCKER_TARGET=api-production
COMPOSE_PROJECT_NAME=flow-wallet

# Service Ports
API_PORT=3000
API_V2_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
EMULATOR_PORT=3569
EMULATOR_GRPC_PORT=3570
DOCS_PORT=8080
PGADMIN_PORT=5050
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Database Configuration
DATABASE_TYPE=postgres
POSTGRES_DB=wallet
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
DATABASE_DSN=postgres://wallet:wallet@postgres:5432/wallet?sslmode=disable

# Redis Configuration  
REDIS_URL=redis://redis:6379
DISABLE_IDEMPOTENCY=false

# Flow Blockchain
ACCESS_API_HOST=emulator:3569
CHAIN_ID=flow-emulator
EMULATOR_VERSION=latest

# Admin Account (Flow Emulator defaults)
ADMIN_ADDRESS=0xf8d6e0586b0a20c7
ADMIN_PRIVATE_KEY=91a22fbd87392b019fbe332c32695c14cf2ba5b6521476a8540228bdf1987068
ENCRYPTION_KEY=faae4ed1c30f4e4555ee3a71f1044a8e

# Enabled Tokens
ENABLED_TOKENS=FlowToken:0x0ae53cb6e3f42a79:flowToken,FUSD:0xf8d6e0586b0a20c7:fusd

# Mode Flags
LIGHTWEIGHT_MODE=false
QUAVE_MODE=false

# Development Tools
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Flow Service Account (for emulator)
FLOW_SERVICE_PRIVATE_KEY=
FLOW_SERVICE_KEY_SIG_ALGO=ECDSA_P256
FLOW_SERVICE_KEY_HASH_ALGO=SHA3_256